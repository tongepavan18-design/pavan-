# Copy to .env and fill in. Never put these keys in HTML/JS.
PORT=3000

# Your GitHub Pages origin (no trailing slash, no path)
ALLOWED_ORIGIN=https://tongepavan18-design.github.io

# FREE: Telegram bot. Create via @BotFather in Telegram -> /newbot -> copy token
TELEGRAM_BOT_TOKEN=

# OPTIONAL (paid SMS). Leave empty to skip.
FAST2SMS_API_KEY=
